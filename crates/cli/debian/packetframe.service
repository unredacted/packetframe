[Unit]
Description=PacketFrame eBPF data plane
Documentation=https://github.com/unredacted/packetframe
After=network-online.target
Wants=network-online.target

# Give up rather than crash-loop. bpffs pins survive SIGTERM by design
# (SPEC.md §8.5) and fast-path refuses to start over existing pins
# ("run `packetframe detach --all` before restarting"), so ANY non-clean
# exit after a successful attach makes every subsequent start fail the
# same way. Without a cap that is an infinite loop with the dataplane
# still forwarding on a frozen FIB — the 2026-07-31/08-01 production
# incident, automated.
#
# systemd's defaults (5 starts per 10s) cannot fire here: RestartSec=5
# means at most ~2 starts land in a 10s window, so the counter resets
# forever. The interval has to be longer than burst*RestartSec to mean
# anything. 3 starts per 5 minutes gives up ~15s into a hard loop while
# still auto-recovering a box that trips once every few hours.
#
# Recovery from the resulting `failed` state is the documented teardown:
# `systemctl stop packetframe && packetframe detach --all`, then
# `systemctl reset-failed packetframe && systemctl start packetframe`.
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
ExecStart=/usr/bin/packetframe run
ExecReload=/bin/kill -HUP $MAINPID
PIDFile=/var/lib/packetframe/state/packetframe.pid
Restart=on-failure
RestartSec=5
User=root
Group=root
StateDirectory=packetframe
StateDirectoryMode=0750
# VPP's startup.conf logs to /var/log/packetframe/vpp.log, and VPP does
# not create the directory: on the rig it did not exist, so VPP ran with
# no log at all and its death left no trace. Created at every start.
LogsDirectory=packetframe
StandardOutput=journal
StandardError=journal
SyslogIdentifier=packetframe
# `process`, not `mixed`: systemd must signal ONLY the daemon.
#
# vpp-offload's VPP is the daemon's child, so it lives in this unit's
# cgroup, and the design keeps it running when the daemon exits
# (SPEC.md §8.5 preserve-on-exit) so the next daemon adopts it and a
# restart is not a resync. `mixed` defeated that: once the main process
# exited, systemd SIGKILLed everything left in the cgroup — VPP
# included — while its MCAM rules stayed in the NIC, steering traffic
# into a VF nothing serviced. Measured on the lab rig (2026-09-23):
# "Killing process … (vpp_main) with signal SIGKILL" one millisecond
# after the daemon logged "VPP is left running and adoptable". A crash
# was worse than a stop: the start limit gives up, and the rules stay
# until someone runs `detach` by hand.
#
# With `process`, VPP outlives the daemon as designed: the documented
# teardown (`stop` then `detach --all`) removes steering first and only
# then terminates VPP, and a crash leaves VPP forwarding on a frozen FIB
# — the same accepted state as fast-path's pins. The daemon's other
# children (vtysh/birdc probes) are short-lived and finish on their own.
# systemd >= 250 logs a deprecation note for this mode; the fleet runs
# 247. Moving VPP into its own scope is the longer-term shape.
KillMode=process
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
